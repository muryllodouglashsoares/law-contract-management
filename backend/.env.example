# LexContract — backend. Copie para `.env` (nunca versione o .env real).
#   cp .env.example .env

NODE_ENV=development
PORT=3333

# --- Banco -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexcontract?schema=public
# Usada pelas migrations do Prisma (em Neon/pooler, aponte para a conexão direta).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/lexcontract?schema=public

# --- Autenticação -------------------------------------------------------
# OBRIGATÓRIA (mín. 16 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- CORS / logs / rate limit do login -----------------------------------
# Várias origens separadas por vírgula.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute

# --- Seed de DESENVOLVIMENTO/TESTE (npm run db:seed) -----------------------
# O seed cria 3 usuários de exemplo (ADMIN, LAWYER, ASSISTANT) e é BLOQUEADO quando
# NODE_ENV=production. Não há senha fixa no código: defina uma senha de desenvolvimento
# (mín. 8 caracteres) apenas no seu .env local. NUNCA use estas variáveis em produção.
#   SEED_PASSWORD         -> mesma senha para os três usuários, OU
#   SEED_ADMIN_PASSWORD / SEED_LAWYER_PASSWORD / SEED_ASSISTANT_PASSWORD -> uma por usuário
# (as específicas têm prioridade sobre SEED_PASSWORD). Os testes E2E usam a mesma senha.
SEED_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_LAWYER_PASSWORD=
SEED_ASSISTANT_PASSWORD=

# --- Cron diário de alertas de renovação (GitHub Actions) ----------------
# Segredo (mín. 32 caracteres) do POST /internal/jobs/contract-renewal-alerts.
# Deve ser IGUAL ao secret CRON_SECRET do repositório no GitHub
# (Settings → Secrets and variables → Actions). Vazio = endpoint desabilitado (404).
CRON_SECRET=

# --- Aceite eletrônico por link público ----------------------------------
# Origem pública do FRONTEND (sem barra final). Em produção é obrigatória para gerar links.
PUBLIC_APP_URL=http://localhost:5173
# Validade do link em horas.
PUBLIC_SIGNATURE_EXPIRATION_HOURS=72
# Rate limit por IP dos endpoints públicos (o POST .../sign usa 1/3 do máximo, mín. 3).
PUBLIC_SIGNATURE_RATE_LIMIT_MAX=30
PUBLIC_SIGNATURE_RATE_LIMIT_WINDOW=1 minute

# --- Web Push (notificações do navegador) -------------------------------
# Opcional: vazio = Web Push desativado. Se preencher, preencha as TRÊS.
# Gere o par de chaves uma única vez (e reutilize em todos os ambientes que
# compartilham usuários — trocar as chaves invalida todas as subscriptions):
#   npx web-push generate-vapid-keys --json
# A chave privada NUNCA vai para o frontend nem para o git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do remetente: mailto:email@seudominio.com ou uma URL https.
VAPID_SUBJECT=

# --- Storage de documentos ------------------------------------------------
# `local` (dev; efêmero em containers) ou `neon-s3` (produção; exige S3_*).
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Sentry (opcional; captura de erros) ---------------------------------
# Sem SENTRY_DSN o Sentry fica desativado. SENTRY_ENVIRONMENT assume NODE_ENV se vazio.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- Alertas automáticos (jobs diários) ----------------------------------
# Chamados por .github/workflows/alerts-cron.yml (mesmo CRON_SECRET do job de renovação).
# POST /internal/jobs/payment-due-alerts   → parcelas: 3 dias antes / no dia / 1 dia depois
# POST /internal/jobs/signature-link-alerts → links de assinatura: nunca abertos / perto de expirar
PAYMENT_ALERT_ENABLED=true
SIGNATURE_ALERT_ENABLED=true
# Link enviado e ainda não aberto após N horas.
SIGNATURE_ALERT_NEVER_OPENED_HOURS=24
# Link que expira em até N horas.
SIGNATURE_ALERT_EXPIRING_HOURS=24

# --- E-mail automático (opcional; nenhum serviço pago é obrigatório) -----
# Com EMAIL_ENABLED=false ou EMAIL_PROVIDER=none o sistema funciona normalmente, só não envia
# e-mails (os botões de copiar link e WhatsApp continuam). Providers: none | log | emailjs.
EMAIL_ENABLED=false
EMAIL_PROVIDER=none
# EmailJS (plano gratuito) — exige habilitar "Allow EmailJS API for non-browser applications".
# Template com as variáveis {{to_email}} {{to_name}} {{subject}} {{message}} {{action_label}} {{action_url}}.
# A chave PRIVADA fica somente no backend. Nunca commite valores reais.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- 2FA (TOTP) para ADMIN e LAWYER ---------------------------------------
# 32 bytes (hex de 64 caracteres ou base64) que criptografam os segredos TOTP em repouso:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Em PRODUÇÃO, sem esta chave o 2FA fica INDISPONÍVEL (o login normal não é afetado).
# Em dev/teste, sem ela, uma chave é derivada do JWT_SECRET. Trocar a chave invalida os 2FA existentes.
TWO_FACTOR_ENCRYPTION_KEY=
# Nome exibido no aplicativo autenticador.
TWO_FACTOR_ISSUER=LexContract
