// Prisma schema — LexContract
//
// Multi-tenant por escritório: todo recurso de negócio referencia
// officeId para isolamento de dados entre escritórios (nunca confie
// apenas no frontend para essa garantia — o isolamento é reforçado
// em cada service, filtrando sempre por officeId do usuário autenticado).
//
// Convenção de enums: valores em inglês (consistente com UserRole/
// UserStatus já existentes). A tradução para os rótulos em português
// usados pelo frontend (StatusBadge / statusConfig em src/data/mock.ts)
// acontece na camada de serialização da API (shared/utils/serialize-*),
// nunca no banco — assim o frontend existente não precisa ser alterado.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  LAWYER
  ASSISTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// Escritório de advocacia — unidade organizacional principal (tenant).
model Office {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  document    String   @unique
  address     String?
  specialties String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  clients           Client[]
  contractTemplates ContractTemplate[]
  contracts         Contract[]
  documents         Document[]
  payments          Payment[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@map("offices")
}

/// Usuário do sistema, sempre vinculado a um escritório (tenant).
model User {
  id           String     @id @default(uuid())
  officeId     String
  name         String
  email        String     @unique
  phone        String?
  oabNumber    String?
  passwordHash String
  role         UserRole   @default(ASSISTANT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  contractsResponsible Contract[]        @relation("ContractResponsible")
  contractVersions     ContractVersion[]
  documentsUploaded    Document[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@index([officeId])
  @@map("users")
}

// ---------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------

enum ClientType {
  PF
  PJ
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

/// Cliente do escritório (pessoa física ou jurídica) — parte contratante.
model Client {
  id        String       @id @default(uuid())
  officeId  String
  type      ClientType
  name      String
  document  String
  email     String
  phone     String?
  address   String?
  notes     String?
  status    ClientStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  office    Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  contracts Contract[]

  // O mesmo CPF/CNPJ não pode ser cadastrado duas vezes no mesmo escritório,
  // mas escritórios diferentes (tenants) são isolados entre si.
  @@unique([officeId, document])
  @@index([officeId])
  @@map("clients")
}

// ---------------------------------------------------------------------
// Modelos de contrato
// ---------------------------------------------------------------------

enum ContractTemplateStatus {
  ACTIVE
  DRAFT
}

/// Modelo/template reutilizável de contrato, com variáveis {{grupo.campo}}
/// substituídas na geração de uma ContractVersion.
model ContractTemplate {
  id          String                  @id @default(uuid())
  officeId    String
  name        String
  description String?
  content     String
  status      ContractTemplateStatus  @default(ACTIVE)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  office    Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  contracts Contract[]

  @@index([officeId])
  @@map("contract_templates")
}

// ---------------------------------------------------------------------
// Contratos
// ---------------------------------------------------------------------

enum ContractStatus {
  RASCUNHO
  PRONTO_ENVIO
  ENVIADO
  EM_REVISAO
  ASSINADO
  ATIVO
  ENCERRADO
  CANCELADO
}

/// Contrato — domínio principal do produto.
/// `number` é um identificador curto e sequencial só para exibição
/// (ex.: "#102"); `id` (uuid) é a chave real usada em relacionamentos e rotas.
model Contract {
  id             String         @id @default(uuid())
  number         Int            @unique @default(autoincrement())
  officeId       String
  clientId       String
  templateId     String
  responsibleId  String
  status         ContractStatus @default(RASCUNHO)
  value          Decimal        @db.Decimal(12, 2)
  object         String
  startDate      DateTime
  termText       String?
  conditions     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  office      Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client      Client            @relation(fields: [clientId], references: [id])
  template    ContractTemplate  @relation(fields: [templateId], references: [id])
  responsible User              @relation("ContractResponsible", fields: [responsibleId], references: [id])
  versions    ContractVersion[]
  documents   Document[]
  payments    Payment[]

  @@index([officeId])
  @@index([officeId, status])
  @@index([clientId])
  @@map("contracts")
}

/// Snapshot versionado do conteúdo gerado de um contrato (template + variáveis
/// preenchidas). Uma nova versão é criada sempre que os dados que afetam o
/// texto do contrato são alterados enquanto ele ainda está em RASCUNHO.
model ContractVersion {
  id            String   @id @default(uuid())
  contractId    String
  versionNumber Int
  content       String
  authorId      String
  createdAt     DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])
  document Document?

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@map("contract_versions")
}

// ---------------------------------------------------------------------
// Documentos
// ---------------------------------------------------------------------

enum DocumentCategory {
  CONTRATO
  PROCURACAO
  DOCUMENTO
  OUTRO
}

/// Metadados de um arquivo anexado a um contrato. O conteúdo binário fica
/// fora do PostgreSQL (disco local em dev, referenciado por `storagePath`;
/// em produção o mesmo campo passaria a guardar a chave de um object storage
/// como S3 — a troca de storage não exige alterar o schema).
model Document {
  id           String           @id @default(uuid())
  officeId     String
  contractId   String
  uploadedById String
  /// Preenchido apenas em PDFs gerados pelo sistema a partir de uma
  /// ContractVersion. @unique => no máximo um PDF por versão (imutável);
  /// uploads manuais e documentos antigos ficam com null.
  contractVersionId String? @unique
  fileName     String
  fileType     String
  mimeType     String
  sizeBytes    Int
  category     DocumentCategory @default(DOCUMENTO)
  /// Chave do objeto no storage (`{officeId}/{uuid}.{ext}`). O nome histórico
  /// da coluna foi mantido para não exigir renomeação; vale para qualquer driver.
  storagePath  String
  /// SHA-256 (hex, 64 chars) do conteúdo binário. Preenchido nos PDFs gerados
  /// a partir de uma ContractVersion; null em uploads manuais e documentos antigos.
  contentHash  String?          @db.Char(64)
  createdAt    DateTime         @default(now())

  office     Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])
  contractVersion ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([contractId])
  @@map("documents")
}

// ---------------------------------------------------------------------
// Pagamentos
// ---------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  PIX
  TRANSFERENCIA
  BOLETO
  DINHEIRO
  CARTAO
}

/// Parcela/pagamento vinculado a um contrato.
/// Não existe um estado "atrasado" persistido: atraso é sempre derivado
/// comparando `dueDate` com a data atual para o status PENDING, evitando
/// um campo que ficaria desatualizado sem um job agendado.
model Payment {
  id                String         @id @default(uuid())
  officeId          String
  contractId        String
  installmentNumber Int
  installmentTotal  Int
  value             Decimal        @db.Decimal(12, 2)
  dueDate           DateTime
  status            PaymentStatus  @default(PENDING)
  method            PaymentMethod?
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  office   Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([officeId])
  @@index([contractId])
  @@index([officeId, status])
  @@map("payments")
}

// ---------------------------------------------------------------------
// Notificações
// ---------------------------------------------------------------------

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

/// Notificação dirigida a um usuário específico do escritório.
model Notification {
  id          String           @id @default(uuid())
  officeId    String
  userId      String
  type        NotificationType @default(INFO)
  title       String
  description String
  priority    Boolean          @default(false)
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([officeId])
  @@index([userId, read])
  @@map("notifications")
}

// ---------------------------------------------------------------------
// Auditoria
// ---------------------------------------------------------------------

/// Registro de auditoria de ações relevantes no sistema. Diferente de
/// Notification: é escrito exclusivamente pelo backend (nunca pelo
/// frontend) e não é destinado a um único usuário — representa a
/// rastreabilidade completa do escritório (HistoryPage).
/// O nome do autor não é duplicado aqui: quando `actorId` existe, o nome
/// exibido vem do relacionamento com User (join na leitura); `actorLabel`
/// só é usado como rótulo para ações sem um usuário humano (ex.: "Sistema").
model AuditLog {
  id          String   @id @default(uuid())
  officeId    String
  actorId     String?
  actorLabel  String?
  action      String
  entityType  String
  entityId    String
  entityLabel String
  createdAt   DateTime @default(now())

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([officeId, createdAt])
  @@map("audit_logs")
}
