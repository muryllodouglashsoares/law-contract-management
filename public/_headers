# Security headers do frontend — Cloudflare Pages lê este arquivo no deploy.
#
# __API_ORIGIN__ é substituído no `npm run build` pela origem de VITE_API_URL
# (ver plugin `securityHeadersApiOrigin` em vite.config.ts), para a CSP nunca
# ficar dessincronizada da URL da API usada pelo bundle.
#
# CSP baseada no que o app realmente usa:
#  - Google Fonts (src/index.css): style-src googleapis + font-src gstatic
#  - API: connect-src (fetch para VITE_API_URL)
#  - PDF: iframe apontando para Blob URL (ContractPdfPanel) -> frame-src blob:
#  - Blob/data em imagens; estilos inline (Tailwind/React style={{}}) -> 'unsafe-inline' só em style-src
#  - Nenhum script inline nem eval: script-src 'self'
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' __API_ORIGIN__; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Página pública de aceite eletrônico: o token está na URL, então não pode vazar via
# Referer nem ser indexada. `!` remove o Referrer-Policy herdado de /* antes de redefini-lo
# (sem isso o Cloudflare concatenaria os dois valores).
/assinar/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
